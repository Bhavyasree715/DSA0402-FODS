# BANK CUSTOMER SUBSCRIPTION PREDICTION AND CUSTOMER SEGMENTATION
# Complete executable program for Google Colab

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy import stats
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, classification_report
from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA

# 1. LOAD DATASET
# Upload bank.csv or change the file path below.
from google.colab import files
uploaded = files.upload()

file_name = list(uploaded.keys())[0]
df = pd.read_csv(file_name, sep=None, engine="python")

print("Dataset Shape:", df.shape)
print("\nFirst 5 Rows:")
print(df.head())

print("\nData Types:")
print(df.dtypes)

print("\nMissing Values:")
print(df.isnull().sum())

# 2. CLEANING
df.columns = [c.strip().lower().replace(" ", "_") for c in df.columns]
df = df.drop_duplicates().copy()

# Common UCI Bank Marketing target name
target_col = "y" if "y" in df.columns else df.columns[-1]
df[target_col] = df[target_col].astype(str).str.strip().str.lower()
df[target_col] = df[target_col].map({"yes": 1, "no": 0})

# Remove rows with unknown target, if any
df = df.dropna(subset=[target_col]).copy()

print("\nShape after cleaning:", df.shape)
print("\nSubscription Distribution:")
print(df[target_col].value_counts())

# 3. EDA
numeric_cols = df.select_dtypes(include=np.number).columns.tolist()
feature_numeric = [c for c in numeric_cols if c != target_col]

if "age" in df.columns:
    plt.figure(figsize=(7,4))
    plt.hist(df["age"], bins=25, edgecolor="black")
    plt.title("Figure 1: Distribution of Customer Age")
    plt.xlabel("Age")
    plt.ylabel("Frequency")
    plt.show()

plt.figure(figsize=(6,4))
df[target_col].value_counts().sort_index().plot(kind="bar", edgecolor="black")
plt.title("Figure 2: Subscription Distribution")
plt.xlabel("Subscription (0 = No, 1 = Yes)")
plt.ylabel("Number of Customers")
plt.show()

# Box plot for a numerical feature
box_feature = "balance" if "balance" in df.columns else feature_numeric[0]
plt.figure(figsize=(7,4))
plt.boxplot(df[box_feature].dropna())
plt.title(f"Figure 3: Outlier Analysis of {box_feature}")
plt.ylabel(box_feature)
plt.show()

# 4. DESCRIPTIVE STATISTICS
print("\nDescriptive Statistics:")
print(df[feature_numeric].describe())

print("\nMean:")
print(df[feature_numeric].mean())

print("\nVariance:")
print(df[feature_numeric].var())

# Covariance and correlation
cov_matrix = df[feature_numeric].cov()
corr_matrix = df[feature_numeric].corr()

print("\nCovariance Matrix:")
print(cov_matrix.round(3))

print("\nCorrelation Matrix:")
print(corr_matrix.round(3))

# Correlation heatmap using Matplotlib only
plt.figure(figsize=(10,8))
plt.imshow(corr_matrix, aspect="auto")
plt.colorbar(label="Correlation")
plt.xticks(range(len(corr_matrix.columns)), corr_matrix.columns, rotation=90)
plt.yticks(range(len(corr_matrix.index)), corr_matrix.index)
plt.title("Figure 4: Correlation Matrix of Numerical Features")
plt.tight_layout()
plt.show()

# 5. STATISTICAL INFERENCE: 95% CI FOR MEAN AGE
if "age" in df.columns:
    age = df["age"].dropna()
    mean_age = age.mean()
    se = stats.sem(age)
    ci = stats.t.interval(0.95, len(age)-1, loc=mean_age, scale=se)
    print("\nPoint Estimate of Mean Age:", round(mean_age, 3))
    print("95% Confidence Interval for Mean Age:", tuple(round(x,3) for x in ci))

# 6. PREPARE CLASSIFICATION DATA
X = df.drop(columns=[target_col])
y = df[target_col]

categorical_features = X.select_dtypes(include=["object", "category"]).columns.tolist()
numerical_features = X.select_dtypes(include=np.number).columns.tolist()

numeric_transformer = Pipeline([
    ("imputer", SimpleImputer(strategy="median")),
    ("scaler", StandardScaler())
])

categorical_transformer = Pipeline([
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("onehot", OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer([
    ("num", numeric_transformer, numerical_features),
    ("cat", categorical_transformer, categorical_features)
])

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

# 7. MODELS
models = {
    "Logistic Regression": LogisticRegression(max_iter=2000),
    "kNN": KNeighborsClassifier(n_neighbors=7),
    "Decision Tree": DecisionTreeClassifier(
        max_depth=8, min_samples_leaf=5, random_state=42
    )
}

results = []
fitted_models = {}

for name, model in models.items():
    pipe = Pipeline([
        ("preprocessor", preprocessor),
        ("model", model)
    ])

    pipe.fit(X_train, y_train)
    y_pred = pipe.predict(X_test)
    fitted_models[name] = pipe

    acc = accuracy_score(y_test, y_pred)
    prec = precision_score(y_test, y_pred, zero_division=0)
    rec = recall_score(y_test, y_pred, zero_division=0)
    f1 = f1_score(y_test, y_pred, zero_division=0)

    results.append([name, acc, prec, rec, f1])

    print("\n", "="*60)
    print(name)
    print(classification_report(y_test, y_pred, zero_division=0))

    cm = confusion_matrix(y_test, y_pred)
    disp = ConfusionMatrixDisplay(confusion_matrix=cm)
    disp.plot()
    plt.title(f"Figure: Confusion Matrix - {name}")
    plt.show()

results_df = pd.DataFrame(
    results,
    columns=["Model", "Accuracy", "Precision", "Recall", "F1-Score"]
).sort_values("F1-Score", ascending=False)

print("\nMODEL PERFORMANCE COMPARISON")
print(results_df.round(4))

plt.figure(figsize=(8,5))
x = np.arange(len(results_df))
width = 0.18
for i, metric in enumerate(["Accuracy","Precision","Recall","F1-Score"]):
    plt.bar(x + (i-1.5)*width, results_df[metric], width, label=metric)

plt.xticks(x, results_df["Model"], rotation=15)
plt.ylim(0, 1.05)
plt.ylabel("Score")
plt.title("Figure: Classification Model Performance Comparison")
plt.legend()
plt.tight_layout()
plt.show()

best_model = results_df.iloc[0]["Model"]
print("\nBest Model based on F1-Score:", best_model)

# 8. OUTLIER ANALYSIS USING IQR
if box_feature in df.columns:
    q1 = df[box_feature].quantile(0.25)
    q3 = df[box_feature].quantile(0.75)
    iqr = q3 - q1
    lower = q1 - 1.5 * iqr
    upper = q3 + 1.5 * iqr
    outliers = df[(df[box_feature] < lower) | (df[box_feature] > upper)]
    print(f"\nPotential outliers in {box_feature}: {len(outliers)}")

# 9. K-MEANS CLUSTERING
preferred_cluster_features = [
    c for c in ["age", "balance", "duration", "campaign", "previous"]
    if c in df.columns
]

if len(preferred_cluster_features) < 2:
    preferred_cluster_features = feature_numeric[:min(5, len(feature_numeric))]

cluster_data = df[preferred_cluster_features].copy()
cluster_data = cluster_data.fillna(cluster_data.median(numeric_only=True))

scaler_cluster = StandardScaler()
cluster_scaled = scaler_cluster.fit_transform(cluster_data)

# Elbow Method
inertias = []
k_values = range(2, 9)

for k in k_values:
    km = KMeans(n_clusters=k, random_state=42, n_init=10)
    km.fit(cluster_scaled)
    inertias.append(km.inertia_)

plt.figure(figsize=(7,4))
plt.plot(list(k_values), inertias, marker="o")
plt.title("Figure: Elbow Method for Selecting K")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Inertia")
plt.xticks(list(k_values))
plt.grid()
plt.show()

# A reasonable default for interpretation; adjust after observing elbow
optimal_k = 4
kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
df["Cluster"] = kmeans.fit_predict(cluster_scaled)

print("\nCluster Sizes:")
print(df["Cluster"].value_counts().sort_index())

cluster_summary = df.groupby("Cluster")[preferred_cluster_features].mean().round(2)
cluster_summary["Subscription_Rate"] = df.groupby("Cluster")[target_col].mean().round(3)

print("\nCUSTOMER CLUSTER SUMMARY")
print(cluster_summary)

# PCA visualization
pca = PCA(n_components=2, random_state=42)
cluster_pca = pca.fit_transform(cluster_scaled)

plt.figure(figsize=(8,6))
plt.scatter(cluster_pca[:,0], cluster_pca[:,1], c=df["Cluster"])
plt.title("Figure: K-means Customer Clusters (PCA Projection)")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.colorbar(label="Cluster")
plt.show()

print("\nFINAL INTERPRETATION")
print("Customers have been grouped according to demographic, financial and campaign-related characteristics.")
print("Clusters with higher Subscription_Rate should be prioritized for targeted campaigns.")
print("Clusters with lower Subscription_Rate may require different communication channels or lower campaign investment.")

