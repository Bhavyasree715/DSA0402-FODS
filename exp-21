import pandas as pd
import numpy as np
from scipy.stats import norm

df = pd.read_csv("rare_elements.csv")

n = int(input("Sample size: "))
conf = float(input("Confidence level: "))
precision = float(input("Precision: "))

sample = df.iloc[:n, 0]
mean = sample.mean()
se = sample.std() / np.sqrt(n)

z = norm.ppf((1 + conf) / 2)
margin = z * se

print("Mean:", mean)
print("Confidence Interval:", mean-margin, mean+margin)
