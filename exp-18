import pandas as pd
import matplotlib.pyplot as plt
import scipy.stats as stats

df = pd.DataFrame({
    "Age": [23,25,28,30,32,35,36,38,40,42,44,45,47,50,52,55,58,60],
    "Fat": [12,15,18,20,21,23,24,25,27,28,29,30,31,32,34,35,37,39]
})

print(df.mean())
print(df.median())
print(df.std())

df.boxplot()
plt.show()

plt.scatter(df["Age"], df["Fat"])
plt.xlabel("Age")
plt.ylabel("% Fat")
plt.show()

stats.probplot(df["Age"], dist="norm", plot=plt)
plt.show()
